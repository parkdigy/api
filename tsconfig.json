{
  "compilerOptions": {
    "target": "ES2017",
    "module": "ESNext",
    "lib": ["ES2017"],
    "moduleResolution": "bundler",
    "declaration": true,
    "declarationDir": "dist",
    "rootDir": "src",
    "noImplicitAny": true,
    "esModuleInterop": true,
    "allowImportingTsExtensions": false,
    "allowSyntheticDefaultImports": true,
    "verbatimModuleSyntax": true,
    "experimentalDecorators": true,
    "preserveSymlinks": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "strict": true,
    "outDir": "dist"
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "test", "dist", "src/**/*.test.ts", "src/**/*.test.tsx", "examples", "rollup.config.js"]
}
